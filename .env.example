# Copy to .env and fill in real values. Never commit .env.

# Server-only (no NEXT_PUBLIC_ prefix): where next.config.ts forwards /api/backend/*
#   local      -> http://localhost:8000
#   production -> https://elvate-rest-api.onrender.com  (set in Vercel dashboard)
BACKEND_URL=http://localhost:8000

# Browser-side base URL for API calls. Keep it as the proxy path so the backend's
# `session` cookie is stored under this site's domain (required for login to work
# when frontend and backend are on different hosts).
NEXT_PUBLIC_BACKEND_URL=/api/backend

# Public URL of this frontend (local -> http://localhost:3000, prod -> https://elvate.vercel.app)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Base64-encoded 32-byte key used to decrypt the session cookie.
# MUST be identical to COOKIES_SECRET in the backend. Generate with: openssl rand -base64 32
COOKIES_SECRET=your_base64_cookies_secret


# Server-only shared secret for the /api/backend proxy (SEC-06 / FSEC-06). middleware.ts sends it with the
# client IP so the backend can trust that IP for rate limits. Must equal PROXY_SHARED_SECRET on the backend.
# Never prefix with NEXT_PUBLIC_. Generate with: openssl rand -base64 32. Leave empty locally if the backend has none.
PROXY_SHARED_SECRET=

# Server-only: the ImageKit "URL endpoint" from its dashboard (BE-28 / FE-28). next.config.ts serves shop photos
# from it under /img/..., so the address never reaches the browser. Never prefix with NEXT_PUBLIC_.
IMAGEKIT_URL_ENDPOINT=
